---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const materials = await getCollection('materials');
  return materials.map(m => ({ params: { slug: m.id } }));
}

const { slug } = Astro.params;
const materials = await getCollection('materials');
const material = materials.find(m => m.id === slug)!;

// Find related cases
const allCases = await getCollection('cases');
const relatedCases = allCases.filter(c =>
  c.data.materials.includes(material.data.title)
);
const allBooks = await getCollection('books');
const relatedBooks = allBooks.filter(b => {
  const sharedTags = (b.data.tags || []).filter(t => (material.data.tags || []).includes(t));
  return sharedTags.length > 0;
}).slice(0, 5);
---

<BaseLayout title={material.data.title} description={material.data.description}>
  <article class="content-container" style="padding-top: var(--space-xl);">
    <header class="detail-header">
      <h1 class="detail-title">{material.data.title}</h1>

      <div class="detail-meta">
        <div class="detail-meta-item">
          <span class="detail-meta-label">类别</span>
          <span>{material.data.category}</span>
        </div>
        {material.data.subcategory && (
          <div class="detail-meta-item">
            <span class="detail-meta-label">子类</span>
            <span>{material.data.subcategory}</span>
          </div>
        )}
      </div>

      <div class="tag-list" style="margin-top: var(--space-md);">
        {material.data.scenarios.map(s => <span class="tag">{s}</span>)}
        {material.data.tags.map(t => <span class="tag">{t}</span>)}
      </div>
    </header>

    {material.data.images && material.data.images.length > 0 && (
      <img class="detail-image lightbox-trigger" src={material.data.images[0]} alt={material.data.title} data-index="0" />
    )}

    {material.data.images && material.data.images.length > 1 && (
      <section style="margin-top: var(--space-xl);">
        <h3 style="margin-bottom: var(--space-md);">更多图片</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--space-md);">
          {material.data.images.slice(1).map((img, i) => (
            <img src={img} alt={material.data.title} class="lightbox-trigger" data-index={i + 1} style="border: 1px solid var(--color-border); cursor: pointer;" loading="lazy" />
          ))}
        </div>
      </section>
    )}

    <!-- Lightbox -->
    <div id="lightbox" class="lightbox-overlay" data-images={JSON.stringify(material.data.images || [])}>
      <span class="lightbox-close">&times;</span>
      <span class="lightbox-arrow lightbox-prev">&lsaquo;</span>
      <span class="lightbox-arrow lightbox-next">&rsaquo;</span>
      <img id="lightbox-img" class="lightbox-img" src="" alt="" />
    </div>
    <script>
      const allImages = JSON.parse(document.getElementById('lightbox').dataset.images);
      let currentIdx = 0;
      const triggers = document.querySelectorAll('.lightbox-trigger');
      const overlay = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      function showImage(idx) {
        currentIdx = idx; lightboxImg.src = allImages[idx];
        document.querySelector('.lightbox-prev').style.visibility = idx > 0 ? 'visible' : 'hidden';
        document.querySelector('.lightbox-next').style.visibility = idx < allImages.length - 1 ? 'visible' : 'hidden';
      }
      function openLightbox(idx) { showImage(idx); overlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
      function closeLightbox() { overlay.classList.remove('active'); document.body.style.overflow = ''; }
      triggers.forEach(img => { img.style.cursor = 'pointer'; img.addEventListener('click', () => openLightbox(parseInt(img.dataset.index) || 0)); });
      document.querySelector('.lightbox-prev').addEventListener('click', e => { e.stopPropagation(); if (currentIdx > 0) showImage(currentIdx - 1); });
      document.querySelector('.lightbox-next').addEventListener('click', e => { e.stopPropagation(); if (currentIdx < allImages.length - 1) showImage(currentIdx + 1); });
      document.querySelector('.lightbox-close').addEventListener('click', closeLightbox);
      overlay.addEventListener('click', e => { if (e.target === overlay) closeLightbox(); });
      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft' && overlay.classList.contains('active') && currentIdx > 0) showImage(currentIdx - 1);
        if (e.key === 'ArrowRight' && overlay.classList.contains('active') && currentIdx < allImages.length - 1) showImage(currentIdx + 1);
      });
    </script>
    <style>
      .lightbox-overlay { display:none;position:fixed;inset:0;background:rgba(0,0,0,0.93);z-index:9999;align-items:center;justify-content:center; }
      .lightbox-overlay.active { display:flex; }
      .lightbox-img { max-width:92vw;max-height:92vh;object-fit:contain;cursor:default;user-select:none; }
      .lightbox-close { position:absolute;top:1.2rem;right:1.6rem;color:#fff;font-size:2rem;cursor:pointer;z-index:10000;line-height:1;opacity:0.5;font-weight:200; }
      .lightbox-close:hover { opacity:0.9; }
      .lightbox-arrow { position:absolute;top:50%;transform:translateY(-50%);color:#fff;font-size:3rem;font-weight:200;cursor:pointer;z-index:10000;opacity:0.4;padding:1rem;user-select:none; }
      .lightbox-arrow:hover { opacity:0.85; }
      .lightbox-prev { left:0.5rem; } .lightbox-next { right:0.5rem; }
    </style>

    <div class="detail-content" set:html={material.rendered?.html || material.body || ''} />

    {material.data.properties.length > 0 && (
      <section style="margin-top: var(--space-lg);">
        <h3>性能参数</h3>
        <table class="prop-table">
          <tbody>
            {material.data.properties.map(p => (
              <tr>
                <th>{p.name}</th>
                <td>{p.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    {material.data.supplier && (
      <section style="margin-top: var(--space-lg);">
        <h3>供应商</h3>
        <p>
          {material.data.supplier.url ? (
            <a href={material.data.supplier.url} target="_blank" rel="noopener">
              {material.data.supplier.name}
            </a>
          ) : (
            material.data.supplier.name
          )}
        </p>
      </section>
    )}

    {material.data.scenarios.length > 0 && (
      <section style="margin-top: var(--space-lg);">
        <h3>适用场景</h3>
        <ul class="related-list">
          {material.data.scenarios.map(s => <li>{s}</li>)}
        </ul>
      </section>
    )}

    {relatedCases.length > 0 && (
      <section class="related-section">
        <h3>关联案例</h3>
        <ul class="related-list">
          {relatedCases.map(c => (
            <li><a href={`/cases/${c.id}/`}>{c.data.title}</a> — {c.data.architect}</li>
          ))}
        </ul>
      </section>
    )}

    {relatedBooks && relatedBooks.length > 0 && (
      <section class="related-section">
        <h3>相关书目</h3>
        <ul class="related-list">
          {relatedBooks.map(b => (
            <li><a href={`/books/${b.id}/`}>{b.data.title}</a> — {b.data.author}</li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
