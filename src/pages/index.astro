---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import CaseCard from '../components/CaseCard.astro';
import MaterialCard from '../components/MaterialCard.astro';
import BookCard from '../components/BookCard.astro';
import { statSync } from 'node:fs';

const cases = (await getCollection('cases'))
  .map(c => ({ ...c, _mtime: statSync(c.filePath).mtimeMs }))
  .sort((a, b) => {
    const orderA = a.data.order ?? 0;
    const orderB = b.data.order ?? 0;
    if (orderA !== orderB) return orderB - orderA;
    return b._mtime - a._mtime;
  })
  .slice(0, 9);
const materials = (await getCollection('materials')).slice(0, 6);
const books = (await getCollection('books')).slice(0, 6);
---

<BaseLayout
  title="咏迹探所 · YJ Atlas — 建筑案例研究、材料手册与阅读书目"
  description="咏迹探所（YJ Atlas）是面向建筑学专业学生和从业者的知识平台，提供全球建筑案例研究、建筑材料手册和经典阅读书目。"
>
  <section class="hero">
    <h1 class="hero-title">
      <span class="hero-accent">咏迹探所</span>·YJ Atlas
    </h1>
    <p class="hero-subtitle">
      案例 · 材料 · 书目
    </p>
  </section>

  <div class="container">
    <section class="home-section" style="max-width: 640px; margin: 0 auto var(--space-xl);">
      <form action="/search/" method="GET" style="display: flex; gap: var(--space-sm);">
        <input
          type="text"
          name="q"
          class="search-input"
          placeholder="搜索建筑师、材料、建筑类型、书名……"
          style="margin-bottom: 0;"
        />
        <button type="submit" class="btn-search">搜索</button>
      </form>
    </section>

    <section class="home-section">
      <div class="home-section-header">
        <h2>近期案例</h2>
        <a href="/cases/">全部案例 →</a>
      </div>
      <div class="card-grid">
        {cases.map(c => <CaseCard case={c} />)}
      </div>
    </section>

    <section class="home-section">
      <div class="home-section-header">
        <h2>材料手册</h2>
        <a href="/materials/">全部材料 →</a>
      </div>
      <div class="card-grid">
        {materials.map(m => <MaterialCard material={m} />)}
      </div>
    </section>

    <section class="home-section">
      <div class="home-section-header">
        <h2>阅读书目</h2>
        <a href="/books/">全部书目 →</a>
      </div>
      <div class="card-grid">
        {books.map(b => <BookCard book={b} />)}
      </div>
    </section>
  </div>
</BaseLayout>
